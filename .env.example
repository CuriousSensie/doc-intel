# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MVP Boilerplate"
SUPPORT_EMAIL=support@example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
# EMAIL_PROVIDER=console logs rendered emails instead of sending (safe local default).
# EMAIL_PROVIDER=smtp sends through SMTP_* below (works with Hostinger or any SMTP mailbox).
EMAIL_PROVIDER=console
EMAIL_FROM="MVP Boilerplate <no-reply@example.com>"
# Set to reroute every outgoing email to one inbox regardless of the real recipient.
EMAIL_DEV_RECIPIENT=
# Port 465 with SMTP_SECURE=true (implicit TLS), or
# Port 587 with SMTP_SECURE=false (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Security
RATE_LIMIT_MODE=memory
