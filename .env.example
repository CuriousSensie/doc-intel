# Application
NEXT_PUBLIC_APP_URL=https://www.dokumenti.net
NEXT_PUBLIC_APP_NAME="Dokumenti"
SUPPORT_EMAIL=support@dokumenti.net

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_CREDITS_STARTER=
STRIPE_PRICE_CREDITS_GROWTH=
STRIPE_PRICE_CREDITS_SCALE=

# Email
# EMAIL_PROVIDER=console logs rendered emails instead of sending (safe local default).
# EMAIL_PROVIDER=smtp sends through SMTP_* below (works with Hostinger or any SMTP mailbox).
EMAIL_PROVIDER=console
EMAIL_FROM="Dokumenti <no-reply@dokumenti.net>"
# Set to reroute every outgoing email to one inbox regardless of the real recipient.
EMAIL_DEV_RECIPIENT=
# Port 465 with SMTP_SECURE=true (implicit TLS), or
# Port 587 with SMTP_SECURE=false (STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Security
RATE_LIMIT_MODE=memory

# Worker / queueing
# Separate Redis instance from Paperless's Redis.
REDIS_URL=redis://localhost:6379
WORKER_INGEST_CONCURRENCY=8
PAPERLESS_INGEST_RATE_PER_SECOND=4
PAPERLESS_UPLOADS_PER_ORG_PER_MINUTE=120
PAPERLESS_READS_PER_ORG_PER_MINUTE=600
PAPERLESS_HTTP_CONNECTIONS=16
PAPERLESS_STREAM_TIMEOUT_MS=30000

# Paperless
PAPERLESS_ADMIN_URL=
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_TOKEN_ENCRYPTION_KEY=

# File scanning
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Internal webhook
DOKUMENTI_WEBHOOK_SECRET=
