# Pomočnik infra environment — copy to infra/.env and fill in. Never commit infra/.env.
# See docs/SETUP.md for the full setup walkthrough.

# ---------------------------------------------------------------------------------------
# Paperless-ngx (D1) — its own Postgres/Redis, isolated from our business database (D3).
# ---------------------------------------------------------------------------------------
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=
# Required — Django's secret key. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=
# Public URL this Paperless instance is reachable at — used in emails/links it generates.
PAPERLESS_URL=https://paperless.internal.example.com
# Admin superuser bootstrap (used once, for the paperlessAdminClient() — see
# src/lib/paperless/client.ts; the ESLint rule restricts who may import that client).
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_ADMIN_MAIL=
# Encryption key for tenant_paperless_config.api_token_encrypted (AES-GCM, 32 random bytes,
# base64). Generate with: openssl rand -base64 32
PAPERLESS_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------------------
# Event bridge (specs/01-architecture.md §Event bridge)
# ---------------------------------------------------------------------------------------
# Shared HMAC secret between infra/scripts/notify-pomocnik.sh and
# src/app/api/internal/paperless/document-consumed/route.ts. Generate with:
# openssl rand -hex 32
POMOCNIK_WEBHOOK_SECRET=
# Reachable from inside the Docker network only (the `web` service name resolves via the
# `pomocnik` bridge network) — never a public hostname here.
POMOCNIK_INTERNAL_URL=http://web:3000

# ---------------------------------------------------------------------------------------
# Our app (web/worker containers) — see the repo root .env.example for the full list this
# extends (Supabase Cloud project keys, Stripe, SMTP, etc. — ADR-0003 for why Supabase is
# Cloud, not a compose service here).
# ---------------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# BullMQ / our own queue (redis-app service in docker-compose.yml — separate from both of
# Paperless's Redis instances).
REDIS_URL=redis://redis-app:6379
