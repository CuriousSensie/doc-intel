# Documenti infra environment — copy to infra/.env and fill in. Never commit infra/.env.
# See docs/SETUP.md for the full setup walkthrough.

# --- Paperless-ngx (D1) — own Postgres/Redis, isolated from our business database (D3) -----
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=
# python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=
PAPERLESS_URL=https://paperless.internal.example.com
# Admin superuser bootstrap — used once, for paperlessAdminClient() (ESLint-restricted).
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_ADMIN_MAIL=
# openssl rand -base64 32
PAPERLESS_TOKEN_ENCRYPTION_KEY=

# --- Event bridge ---------------------------------------------------------------------------
# Shared with infra/scripts/notify-documenti.sh. openssl rand -hex 32
DOCUMENTI_WEBHOOK_SECRET=
# Docker-network only — never a public hostname.
DOCUMENTI_INTERNAL_URL=http://web:3000

# --- Our app (web/worker) — see repo root .env.example for Supabase/Stripe/SMTP keys -------
NEXT_PUBLIC_APP_URL=https://app.example.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

REDIS_URL=redis://redis-app:6379
WORKER_INGEST_CONCURRENCY=8
PAPERLESS_INGEST_RATE_PER_SECOND=4
PAPERLESS_UPLOADS_PER_ORG_PER_MINUTE=120
PAPERLESS_READS_PER_ORG_PER_MINUTE=600
PAPERLESS_HTTP_CONNECTIONS=16
PAPERLESS_STREAM_TIMEOUT_MS=30000

# --- Host port overrides (all bound to 127.0.0.1 except nginx) — set on shared hosts -------
# WEB_HOST_PORT=3000
# PAPERLESS_HOST_PORT=8010
# PAPERLESS_DB_HOST_PORT=5433
# REDIS_APP_HOST_PORT=6380
# CLAMAV_HOST_PORT=3310
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443
# App -> Paperless inside the compose network (not the public URL).
PAPERLESS_ADMIN_URL=http://paperless-webserver:8000
